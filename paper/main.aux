\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Blur preference $\Lambda $ against diffusion noise level $t$, single held-out image, Gaussian $\sigma =1.5$, corrected kernel (Section\nobreakspace  {}\ref  {sec:bug}); $\mathrm  {sd}(\Lambda )$ from four Hutchinson repeats is $388$ nats ($424$ with the incorrect kernel). $\Lambda _{\rm  Gauss}$ is the same log-ratio evaluated under a Gaussian reference whose per-frequency variance is the radially binned power spectrum of the sharp image plus $t^2$---i.e.\ a second-order model matched to the image's own spectrum. Source: \texttt  {results/tdep\_kfix.json}.\relax }}{4}{table.caption.9}\protected@file@percent }
\newlabel{tab:lamt}{{1}{4}{Blur preference $\Lam $ against diffusion noise level $t$, single held-out image, Gaussian $\sigma =1.5$, corrected kernel (Section~\ref {sec:bug}); $\mathrm {sd}(\Lam )$ from four Hutchinson repeats is $388$ nats ($424$ with the incorrect kernel). $\Lam _{\rm Gauss}$ is the same log-ratio evaluated under a Gaussian reference whose per-frequency variance is the radially binned power spectrum of the sharp image plus $t^2$---i.e.\ a second-order model matched to the image's own spectrum. Source: \texttt {results/tdep\_kfix.json}.\relax }{table.caption.9}{}}
